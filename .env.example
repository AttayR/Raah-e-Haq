# Environment config, read at build time by react-native-config and exposed to JS
# through src/config/env.ts (the app throws at startup if a key is missing).
#
# Copy this file and fill it in. Real env files are git-ignored; only this example is committed.
#   .env.development  -> used by Debug builds   (yarn ios / yarn android)
#   .env.production   -> used by Release builds (yarn ios --mode Release / assembleRelease)
#
# Choosing another file:
#   iOS:     the ENVFILE build setting is set per configuration in ios/Podfile (post_install).
#            Override for one build:  yarn ios --extra-params "ENVFILE=.env.production"
#   Android: debug/release mapping is envConfigFiles in android/app/build.gradle.
#            Override for one build:  ENVFILE=.env.production yarn android
# Values are baked into the native build: after changing an env file, rebuild the app
# (restarting Metro is not enough).

# REST API base URL, no trailing slash. Production: https://raahehaq.com/api
# Local backend from the iOS simulator: http://localhost:8000/api
# Android emulator: http://10.0.2.2:8000/api, or keep localhost and run `adb reverse tcp:8000 tcp:8000`
# The backend's APP_URL (or PAYMENTS_CALLBACK_BASE_URL) origin must equal this origin, or the wallet top-up checkout start check (SEC-43) fails closed.
API_URL=

# Realtime (Laravel Reverb, Pusher protocol; T-406) origin, no trailing slash and no path: scheme,
# host, port. The app connects to {WS_URL}/app/{WS_APP_KEY} (nginx `location /app/` on the server).
# ws:// = http, wss:// = https (forceTLS). Release builds accept wss only.
# Production: wss://raahehaq.com
# Local Reverb from the iOS simulator: ws://127.0.0.1:8080
# Android emulator: ws://10.0.2.2:8080, or keep 127.0.0.1 and run `adb reverse tcp:8080 tcp:8080`
# The app connects only when GET /settings/public meta.realtime is enabled and matches this
# origin (and key); otherwise it keeps polling.
WS_URL=

# Reverb app key (REVERB_APP_KEY on the server; public, not a secret). Empty: realtime off, polling only.
WS_APP_KEY=

# Google Maps key (GOOGLE_MAPS_API_KEY). One value feeds the JS side (env.MAPS_KEY) and both native
# Maps SDKs: Android manifestPlaceholders in android/app/build.gradle, iOS GMSApiKey in Info.plist
# (Info.plist preprocessing). Put the real value only in the git-ignored .env.* files. Never log it.
MAPS_KEY=

# Optional: the native build number shown in Account → version line ("Raah-e-Haq 1.0.0 (42)").
# Android already exposes VERSION_CODE; set this for iOS (or to override). Leave empty to hide it.
APP_BUILD=
