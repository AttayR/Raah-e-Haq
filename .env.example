# Environment config, read at build time by react-native-config and exposed to JS
# through src/config/env.ts (the app throws at startup if a key is missing).
#
# Copy this file and fill it in. Real env files are git-ignored; only this example is committed.
#   .env.development  -> used by Debug builds   (yarn ios / yarn android)
#   .env.production   -> used by Release builds (yarn ios --mode Release / assembleRelease)
#
# Choosing another file:
#   iOS:     the ENVFILE build setting is set per configuration in ios/Podfile (post_install).
#            Override for one build:  yarn ios --extra-params "ENVFILE=.env.production"
#   Android: debug/release mapping is envConfigFiles in android/app/build.gradle.
#            Override for one build:  ENVFILE=.env.production yarn android
# Values are baked into the native build: after changing an env file, rebuild the app
# (restarting Metro is not enough).

# REST API base URL, no trailing slash. Production: https://raahehaq.com/api
# Local backend from the iOS simulator: http://localhost:8000/api
# Android emulator: http://10.0.2.2:8000/api, or keep localhost and run `adb reverse tcp:8000 tcp:8000`
API_URL=

# WebSocket base URL, no trailing slash. Production: wss://raahehaq.com/ws
WS_URL=

# Google Maps / Places / Directions key (JS side). Never commit or log it.
MAPS_KEY=
