<?xml version="1.0" encoding="utf-8"?>
<!--
  Release (and every non-debug) build: HTTPS only, system CAs only. No cleartext to any host.
  Debug builds use src/debug/res/xml/network_security_config.xml, which allows cleartext only
  to localhost, 127.0.0.1 and 10.0.2.2 (Metro and the local backend).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
