<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon (T-531; UI-R8): the system draws it on a 288 dp canvas and shows the
     centre 192 dp circle, so the canvas is 288 dp with the 96 dp white badge and the 64 dp logo
     centred in it, the same size and place as the JS splash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="288dp"
        android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/splash_badge" />
        </shape>
    </item>
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo" />
</layer-list>
