<?xml version="1.0" encoding="UTF-8"?>
<!-- Native splash (T-531, PERF-02; UI-R8 auth-splash): navy-950 in both modes, a 96 pt white
     badge (SplashBadge image: launch screens cannot round a view) holding the 64 pt logo in the exact centre, and the "Raah-e-Haq" wordmark (bold 22,
     white) 16 pt below it, drawn exactly like the JS SplashScreen so the hand-over has no jump.
     The colour and logo live in Images.xcassets (SplashBackground, SplashLogo); the values are in
     src/theme/components.ts `splash` (__tests__/components/SplashScreen.test.tsx checks them). -->
