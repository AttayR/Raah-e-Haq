# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.0'
ENV['NODE_BINARY'] = '/usr/local/bin/node'
prepare_react_native_project!

# Force dynamic frameworks to resolve Swift pod issues
use_frameworks! :linkage => :static

target 'RaaHeHaq' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    # Enable New Architecture but with proper configuration
    :fabric_enabled => true,
    :hermes_enabled => true,
    :new_arch_enabled => true
  )

  # Firebase pods - pin to 12.3.0 to match @react-native-firebase
  pod 'Firebase/Core', '12.3.0'
  pod 'Firebase/Auth', '12.3.0'
  pod 'Firebase/Firestore', '12.3.0'
  pod 'Firebase/Storage', '12.3.0'
  pod 'Firebase/Messaging', '12.3.0'
  pod 'Firebase/Analytics', '12.3.0'
 # React Native Maps dependencies
rn_maps_path = '../node_modules/react-native-maps'
pod 'react-native-maps/Google', :path => rn_maps_path

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
