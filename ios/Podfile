# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

APP_DEPLOYMENT_TARGET = '16.0'
platform :ios, APP_DEPLOYMENT_TARGET
# NODE_BINARY comes from ios/.xcode.env (+ .xcode.env.local), not a hardcoded path.
prepare_react_native_project!

# Force dynamic frameworks to resolve Swift pod issues
use_frameworks! :linkage => :static

target 'RaaHeHaq' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    # Enable New Architecture but with proper configuration
    :fabric_enabled => true,
    :hermes_enabled => true,
    :new_arch_enabled => true
  )

  # Firebase pods - pin to 12.3.0 to match @react-native-firebase
  pod 'Firebase/Core', '12.3.0'
  pod 'Firebase/Auth', '12.3.0'
  pod 'Firebase/Firestore', '12.3.0'
  pod 'Firebase/Storage', '12.3.0'
  pod 'Firebase/Messaging', '12.3.0'
  pod 'Firebase/Analytics', '12.3.0'
 # React Native Maps dependencies
rn_maps_path = '../node_modules/react-native-maps'
pod 'react-native-maps/Google', :path => rn_maps_path

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Newer Xcode versions reject pods that declare an old minimum iOS version
    # ("The iOS Simulator deployment target ... is set to 9.0/10.0/12.0").
    # Raise every pod to the app's minimum so they all build.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || Gem::Version.new(current) < Gem::Version.new(APP_DEPLOYMENT_TARGET)
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = APP_DEPLOYMENT_TARGET
        end

        # fmt 11.0.x (bundled with RN 0.80) fails under the newer Clang in Xcode 26.4+/27
        # with "call to consteval function ... is not a constant expression".
        # Compiling fmt as C++17 disables its consteval format-string checks.
        if target.name == 'fmt'
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end

        # react-native-config: Debug builds read .env.development, Release builds read
        # .env.production. Override one build with:
        #   yarn ios --extra-params "ENVFILE=.env.production"
        if target.name == 'react-native-config'
          build_config.build_settings['ENVFILE'] =
            build_config.name == 'Release' ? '.env.production' : '.env.development'
        end
      end
    end
  end
end
